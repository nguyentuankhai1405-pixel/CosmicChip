    % --- CAP NHAT THONG SO HUD THEO TIEN TRINH ---
    if t_sim < 3.5
        phase_str = 'GIAI DOAN 1: Khoi sinh goi song (Inception & Localization)';
        hud_col = [1 0.8 0.2];
    elseif t_sim < 10.5
