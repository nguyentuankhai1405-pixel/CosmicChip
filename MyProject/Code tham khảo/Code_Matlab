% 1. Ve thanh nhap nhay dang khoi hop 3D
cube_x = [-L/2 L/2 L/2 -L/2 -L/2; -L/2 L/2 L/2 -L/2 -L/2];
cube_y = [-W/2 -W/2 W/2 W/2 -W/2; -W/2 -W/2 W/2 W/2 -W/2];
cube_z = [-H/2 -H/2 -H/2 -H/2 -H/2; H/2 H/2 H/2 H/2 H/2];
% DONG 96 DA SUA: Truyen ma tran hop le vao mesh
mesh(cube_x, cube_y, cube_z, 'FaceAlpha', 0.05, 'EdgeColor', [0.3 0.6 1]);

% 2. Ve cam bien SiPM o dau thanh (+X)
fill3([L/2 L/2 L/2 L/2], [-W/2 W/2 W/2 -W/2], [-H/2 -H/2 H/2 H/2], 'g', 'FaceAlpha', 0.7);
text(L/2 + 0.5, 0, 0, 'SiPM Sensor', 'Color', 'g', 'FontWeight', 'bold');

% Danh dau vi tri hat tuong tac ban dau
plot3(x0, y0, z0, 'yo', 'MarkerFaceColor', 'y', 'MarkerSize', 6);

% 3. Ban cac photon dang huong & Ray tracing
collected = 0;
for i = 1:N_photons
    costheta = 2*rand - 1;
    phi = 2*pi*rand;
    sintheta = sqrt(1 - costheta^2);
    dir = [sintheta*cos(phi), sintheta*sin(phi), costheta];

    pos = [x0, y0, z0];
    ray_pts = pos;
    alive = true;
    bounces = 0;

    while alive && bounces < 20
        dt = [];
        if dir(1) > 0, dt(end+1) = (L/2 - pos(1))/dir(1); else, dt(end+1) = (-L/2 - pos(1))/dir(1); end
        if dir(2) > 0, dt(end+1) = (W/2 - pos(2))/dir(2); else, dt(end+1) = (-W/2 - pos(2))/dir(2); end
        if dir(3) > 0, dt(end+1) = (H/2 - pos(3))/dir(3); else, dt(end+1) = (-H/2 - pos(3))/dir(3); end

        step = min(dt(dt > 1e-5));
        pos = pos + step * dir;
        ray_pts = [ray_pts; pos];

        % Cham sensor SiPM o dau thanh
        if abs(pos(1) - L/2) < 1e-4
            collected = collected + 1;
            plot3(ray_pts(:,1), ray_pts(:,2), ray_pts(:,3), 'g-', 'LineWidth', 1.2);
            break;
        end

        % Phan xa toan phan o cac mat ben
        if abs(pos(2) - W/2) < 1e-4 || abs(pos(2) + W/2) < 1e-4
            dir(2) = -dir(2);
        elseif abs(pos(3) - H/2) < 1e-4 || abs(pos(3) + H/2) < 1e-4
            dir(3) = -dir(3);
        else
            break; % That thoat qua mat sau (-X)
        end
        bounces = bounces + 1;
    end
    if abs(pos(1) - L/2) >= 1e-4
        plot3(ray_pts(:,1), ray_pts(:,2), ray_pts(:,3), 'r:', 'LineWidth', 0.5);
    end
end

grid on;
