%% BOGOLIUBOV - GROSS-PITAEVSKII QUANTUM VORTEX DYNAMICS

clc; clear; close all;

% 1. THIET LAP LUOI KHONG GIAN VA THONG SO VAT LY
N = 128;                       % Do phan giai luoi (128x128)
L = 10;                        % Kich thuoc mien khong gian [-L, L]
x = linspace(-L, L, N);
y = linspace(-L, L, N);
[X, Y] = meshgrid(x, y);
dx = x(2) - x(1);
dt = 0.015;                    % Buoc thoi gian

% Khong gian xung luong Fourier (Momentum Space)
kx = (pi/L) * [0:(N/2-1), -N/2:-1];
ky = (pi/L) * [0:(N/2-1), -N/2:-1];
[KX, KY] = meshgrid(kx, ky);
K2 = KX.^2 + KY.^2;            % Toan tu Dong nang

% The nang giu hat (Harmonic Optical Trap)
omega_trap = 0.8;
V_trap = 0.5 * omega_trap^2 * (X.^2 + Y.^2);

% He so tuong tac phi tuyen day giua cac nguyen tu (Repulsive Interaction)
g = 60.0;

% 2. KHOI TAO TRANG THAI: CONDENSATE + 4 XOAY LUONG TU (QUADRUPOLE)
% Nen Thomas-Fermi
R_TF = 6.2;
psi = sqrt(max(0, (1 - (X.^2 + Y.^2)/R_TF^2) * 1.5));

% Cay 4 xoay luong tu (Vortices) doi xung o ban kinh r0
r0 = 2.4;
vortex_pos = [ r0,  0,  1;   % [x, y, charge +1]
               0,  r0,  1;   % [x, y, charge +1]
              -r0,  0,  1;   % [x, y, charge +1]
               0, -r0,  1];  % [x, y, charge +1]

xi = 0.45; % Do rong loi xoay (Healing length)
for k = 1:size(vortex_pos, 1)
    vx = vortex_pos(k, 1);
    vy = vortex_pos(k, 2);
    charge = vortex_pos(k, 3);
    
    dist = sqrt((X - vx).^2 + (Y - vy).^2);
    % DA FIX: Doi ten bien thanh phi_v de khong de len ham goc angle() cua MATLAB
    phi_v = atan2(Y - vy, X - vx); 
    psi = psi .* (dist ./ sqrt(dist.^2 + xi^2)) .* exp(1i * charge * phi_v);
end

% Chuan hoa tong xac suat
psi = psi / sqrt(sum(abs(psi(:)).^2) * dx^2);

% 3. TOAN TU SPLIT-STEP FOURIER CAP 2 (STRANG SPLITTING)
exp_T = exp(-1i * 0.5 * K2 * dt); % Toan tu dong nang trong Fourier domain

% 4. THIET LAP GIAO DIEN DO HOA 3D & 2D DONG BO
hFig = figure('Color', [0.05 0.05 0.08], 'Position', [60, 60, 1200, 650], ...
              'Name', 'Frontier Quantum Physics: 2D Gross-Pitaevskii Vortices');

% --- KHUNG NHIN 1: 3D DENSITY & QUANTUM PHASE ---
ax1 = subplot(1, 2, 1, 'Parent', hFig);
% Goi ham angle() goc he thong hoan toan binh thuong
hSurf = surf(ax1, X, Y, abs(psi).^2, 'CData', angle(psi), 'EdgeColor', 'none');
colormap(ax1, hsv); 
if exist('clim', 'file') || exist('clim', 'builtin')
    clim(ax1, [-pi, pi]);
else
    caxis(ax1, [-pi, pi]);
end
axis(ax1, [-L L -L L 0 0.12]); axis square;
view(ax1, 35, 45); rotate3d on;
set(ax1, 'Color', [0.05 0.05 0.08], 'XColor', [0.4 0.4 0.5], ...
         'YColor', [0.4 0.4 0.5], 'ZColor', [0.4 0.4 0.5]);
title(ax1, 'Mat Do Hat |\psi|^2 & 4 Loi Xoay (Chieu cao: Mat do, Mau: Pha \theta)', ...
      'Color', 'w', 'FontSize', 11);
lighting gouraud;
light('Position', [10 10 20], 'Style', 'infinite');

% --- KHUNG NHIN 2: 2D TOPOLOGICAL PHASE PORTRAIT ---
ax2 = subplot(1, 2, 2, 'Parent', hFig);
hPhase = imagesc(ax2, x, y, angle(psi));
set(ax2, 'YDir', 'normal'); axis square;
colormap(ax2, hsv); 
if exist('clim', 'file') || exist('clim', 'builtin')
    clim(ax2, [-pi, pi]);
else
    caxis(ax2, [-pi, pi]);
end
cb = colorbar(ax2, 'Location', 'eastoutside');
cb.Color = 'w'; cb.Label.String = 'Pha Luong Tu \theta = arg(\psi) [rad]';
set(ax2, 'Color', 'k', 'XColor', [0.4 0.4 0.5], 'YColor', [0.4 0.4 0.5]);
title(ax2, 'Ban Do Pha To-Po: Tuan Hoan Goc \oint \nabla\theta\cdot dr = 2\pi', ...
      'Color', 'w', 'FontSize', 11);

% Text HUD theo doi bao toan nang luong & xac suat
hHUD = annotation('textbox', [0.32, 0.02, 0.38, 0.06], 'Color', 'y', ...
                  'EdgeColor', [0.3 0.3 0.4], 'BackgroundColor', [0 0 0 0.7], ...
                  'HorizontalAlignment', 'center', 'FontSize', 10, 'FitBoxToText', 'on');

% 5. VONG LAP MO PHONG TUAN HOAN LIEN TUC (REAL-TIME EVOLUTION)
t = 0;
while ishandle(hFig)
    % Thuc hien 4 buoc tich phan GPE cho moi khung hinh de toc do muot ma
    for step = 1:4
        t = t + dt;
        
        % Buoc 1: The nang & Tuong tac phi tuyen (1/2 buoc thoi gian)
        exp_V = exp(-1i * (V_trap + g * abs(psi).^2) * (0.5 * dt));
        psi = exp_V .* psi;
        
        % Buoc 2: Dong nang trong khong gian song Fourier (1 buoc day du)
        psi = ifft2(exp_T .* fft2(psi));
        
        % Buoc 3: The nang & Tuong tac phi tuyen (1/2 buoc thoi gian con lai)
        psi = exp_V .* psi;
        
        % Bao toan tong xac suat (Unitary conservation)
        norm_val = sum(abs(psi(:)).^2) * dx^2;
        psi = psi / sqrt(norm_val);
    end
    
    % Tinh toan bien do mat do va pha bang ham angle() he thong
    density = abs(psi).^2;
    phase_map = angle(psi);
    
    % Cap nhat do hoa thoi gian thuc
    set(hSurf, 'ZData', density, 'CData', phase_map);
    set(hPhase, 'CData', phase_map);
    
    set(hHUD, 'String', sprintf(['Thoi gian luong tu: t = %.2f s | Bao toan hat N = 1.0000\n' ...
                                 'Trang thai: 4 Xoay dong chieu dang vu dieu tuan hoan quanh tam'], t));
    drawnow limitrate; % Toi uu toc do hien thi 60 FPS
end


%% COSMICCHIP MULTI-STAGE DETECTOR SIMULATION IN MATLAB (BASE VERSION)
% Phiên bản tối ưu: Không cần Toolbox, không tràn RAM, chạy dưới 1 giây.
clear; clc; close all;
rng(42); % Cố định seed ngẫu nhiên

% 1. CẤU HÌNH THAM SỐ MÔI TRƯỜNG & VẬT LÝ TẠI VIỆT NAM
T_env = 32.0;         % Nhiệt độ phòng thí nghiệm (°C)
P_atm = 1009.0;       % Áp suất khí quyển thực tế (hPa)
P_0 = 1013.25;        % Áp suất tiêu chuẩn (hPa)
beta_P = -0.0013;     % Hệ số khí áp (-0.13%/hPa)
Sim_Time = 3600;      % Thời gian mô phỏng: 1 giờ (3600 giây)

% 2. THÔNG LƯỢNG HẠT MUON & BỨC XẠ NỀN (TẦNG 1)
% Tốc độ Muon thực tế tại Việt Nam (~0.37 Hz) sau hiệu chỉnh khí áp
R_muon_base = 0.38; 
R_muon = R_muon_base * (1 + beta_P * (P_atm - P_0));

% Bức xạ phóng xạ tự nhiên môi trường (Gamma/Radon xung quanh ~2.1 Hz)
R_background = 2.12; 

% Sinh số lượng sự kiện (Dùng xấp xỉ Gaussian cho Poisson khi lambda lớn)
N_muons = max(0, round(R_muon * Sim_Time + sqrt(R_muon * Sim_Time) * randn()));
N_bg    = max(0, round(R_background * Sim_Time + sqrt(R_background * Sim_Time) * randn()));

% Thời điểm hạt tới (Uniformly distributed)
t_muons = sort(Sim_Time * rand(N_muons, 1));
t_bg    = sort(Sim_Time * rand(N_bg, 1));

% 3. TƯƠNG TÁC NĂNG LƯỢNG & QUANG HỌC (TẦNG 2)
% --- Với Hạt Muon: Phân bố Landau-Moyal (MIP bump ~20 mV) ---
theta = acos(rand(N_muons, 1).^(1/3));      % Góc tới cos^2(theta)
path_length = 1.0 ./ cos(theta);            % Bề dày quỹ đạo qua tấm 1cm (cm)

mu_L = 20.0 * path_length;                  % Đỉnh Landau ~20 mV
c_L = 4.5;                                  % Độ rộng tán xạ
z_m = randn(N_muons, 1);
V_muon_pulse = mu_L + c_L * (z_m - exp(-z_m)); 
V_muon_pulse = max(0, V_muon_pulse);        % Không âm

% --- Với Bức xạ nền môi trường: Phân rã tán xạ Compton (chủ yếu < 10 mV) ---
% Phổ tán xạ Compton giảm theo hàm mũ
V_bg_pulse = -log(rand(N_bg, 1)) * 3.5 + 2.0; 

% 4. TỔNG HỢP VÀ LỌC QUA NGƯỠNG TRIGGER (TẦNG 3 & 4)
% Nhãn: 1 = Muon thật, 0 = Bức xạ nền/Nhiễu
All_Events = [ [t_muons, V_muon_pulse, ones(N_muons, 1)]; ...
               [t_bg,    V_bg_pulse,   zeros(N_bg, 1)] ];
All_Events = sortrows(All_Events, 1); % Sắp xếp theo dòng thời gian

% Ngưỡng kích hoạt Trigger Threshold của CosmicWatch v3X (4.0 mV)
V_threshold = 4.0; % mV
Triggered = All_Events(All_Events(:, 2) >= V_threshold, :);

% Mô phỏng Thời gian chết (Non-paralyzable Dead Time: 408 microseconds)
tau_dead = 408e-6; 
recorded_mask = false(size(Triggered, 1), 1);
t_last = -inf;

for i = 1:size(Triggered, 1)
    if Triggered(i, 1) >= (t_last + tau_dead)
        recorded_mask(i) = true;
        t_last = Triggered(i, 1);
    end
end

Final_Events = Triggered(recorded_mask, :);

% 5. XUẤT KẾT QUẢ ĐỐI SOÁT VỚI THỰC NGHIỆM
Total_Recorded = size(Final_Events, 1);
Muon_Recorded  = sum(Final_Events(:, 3) == 1);
BG_Recorded    = sum(Final_Events(:, 3) == 0);

Measured_Rate = Total_Recorded / Sim_Time;
Muon_Rate     = Muon_Recorded / Sim_Time;

fprintf('================ KẾT QUẢ MÔ PHỎNG COSMICCHIP ================\n');
fprintf('Nhiệt độ phòng: %.1f °C | Áp suất: %.1f hPa\n', T_env, P_atm);
fprintf('Tổng tốc độ đếm ghi nhận (Trigger Rate): %.3f Hz (Chuẩn CW: ~2.5 Hz)\n', Measured_Rate);
fprintf('Tốc độ đếm hạt Muon:                    %.3f Hz (~%.1f hạt/phút)\n', Muon_Rate, Muon_Rate*60);
fprintf('Tỷ lệ Muon / Tổng số sự kiện (Single):  %.2f %%\n', (Muon_Recorded / Total_Recorded) * 100);

% 6. VẼ PHỔ BIÊN ĐỘ XUNG (LANDAU-MOYAL SPECTRUM)
figure('Name', 'CosmicChip Pulse Spectrum', 'Color', 'w', 'Position', [100, 100, 800, 500]);
bins = linspace(0, 80, 80);

h_bg = histogram(Final_Events(Final_Events(:,3)==0, 2), bins, ...
    'FaceColor', [0.85 0.33 0.1], 'FaceAlpha', 0.6, 'EdgeColor', 'none');
hold on;
h_mu = histogram(Final_Events(Final_Events(:,3)==1, 2), bins, ...
    'FaceColor', [0 0.45 0.74], 'FaceAlpha', 0.7, 'EdgeColor', 'none');

% Đánh dấu ngưỡng Trigger và đỉnh MIP
xline(V_threshold, '--r', 'LineWidth', 2, 'Label', 'Ngưỡng Trigger (4 mV)', 'LabelVerticalAlignment', 'top');
xline(20.0, ':k', 'LineWidth', 1.5, 'Label', 'MIP Peak (~20 mV)');

xlabel('Biên độ xung SiPM quy đổi (mV)', 'FontSize', 12, 'FontWeight', 'bold');
ylabel('Số lượng sự kiện / bin', 'FontSize', 12, 'FontWeight', 'bold');
title(sprintf('Phổ biên độ đỉnh xung CosmicChip (Simulated at T = %.1f°C, P = %.1f hPa)', T_env, P_atm), 'FontSize', 13);
legend([h_mu, h_bg], {'Tia vũ trụ Muon (Landau Peak)', 'Bức xạ nền tự nhiên (Compton Tail)'}, 'FontSize', 11);
grid on;
set(gca, 'Box', 'on', 'LineWidth', 1.2);
%% CẤU HÌNH THAM SỐ THỰC TẾ TẠI VIỆT NAM (VIETNAM LOCAL PARAMETERS)
Location = 'HCMC'; % Chọn: 'HANOI', 'HCMC', hoặc 'DALAT'

switch Location
    case 'HANOI'
        Geo_Lat = 21.03;          % Vĩ độ Bắc (độ)
        Geo_Long = 105.85;        % Kinh độ Đông (độ)
        Rc_cutoff = 15.6;         % Độ cứng cắt từ trường (GV)
        Altitude = 10;            % Độ cao so với mực nước biển (m)
        P_atm = 1010.5;           % Áp suất khí quyển trung bình (hPa)
        T_env = 32.0;             % Nhiệt độ môi trường phòng lab (°C)

    case 'HCMC'
        Geo_Lat = 10.82;
        Geo_Long = 106.63;
        Rc_cutoff = 16.9;         % Gần xích đạo từ hơn -> Rc cao nhất
        Altitude = 5;
        P_atm = 1009.0;
        T_env = 33.5;             % Môi trường miền Nam thường nóng hơn

    case 'DALAT'
        Geo_Lat = 11.94;
        Geo_Long = 108.44;
        Rc_cutoff = 16.5;
        Altitude = 1500;          % Cao nguyên 1500m
        P_atm = 852.0;            % Áp suất giảm mạnh theo độ cao
        T_env = 20.0;             % Khí hậu ôn đới mát mẻ
end

% THÔNG LƯỢNG HẠT MUON ĐÃ HIỆU CHỈNH TẠI VIỆT NAM
% 1. Thông lượng cơ bản hiệu chỉnh theo Vĩ độ địa từ (Rc cao làm giảm ~7% so với Mỹ/Âu)
% Tấm nhựa 5x5 cm2 tại Mỹ ~ 0.40 Hz -> Tại VN mực nước biển ~ 0.372 Hz
R_base_sea_level = 0.40 * (1 - 0.005 * (Rc_cutoff - 1.5)); 

% 2. Hiệu chỉnh theo Độ cao (áp dụng mô hình tăng hàm mũ tới 3km)
% Dựa trên thực nghiệm chuyến bay của Spencer Axani (Doc 2, Eq 2.3 & Sec 2.13)
R_altitude_factor = exp(Altitude / 4500); 

% 3. Hiệu chỉnh theo Khí áp địa phương
beta_P = -0.0013; % -0.13 %/hPa
R_muon_VN = R_base_sea_level * R_altitude_factor * (1 + beta_P * (P_atm - 1013.25));

% ĐẶC TÍNH BÁN DẪN SiPM DƯỚI ĐIỀU KIỆN NHIỆT ĐỘ VIỆT NAM
V_br_ref = 24.5;                 % Điện áp breakdown ở 25°C (V)
temp_coeff_Vbr = 0.0215;         % 21.5 mV/°C
V_br_actual = V_br_ref + temp_coeff_Vbr * (T_env - 25.0);

% Nhiễu tối DCR bùng nổ theo nhiệt độ VN
DCR_25C = 30000;                 % 30 kHz cơ sở ở 25°C
DCR_actual = DCR_25C * 2^((T_env - 25.0) / 8.0); 

fprintf('=== THÔNG SỐ VẬT LÝ KHỞI TẠO TẠI: %s ===\n', Location);
fprintf('Độ cứng cắt từ trường (Rc): %.1f GV\n', Rc_cutoff);
fprintf('Tốc độ Muon lý thuyết dự kiến: %.4f Hz (%.1f hạt/phút)\n', R_muon_VN, R_muon_VN*60);
fprintf('Nhiệt độ: %.1f °C | DCR của SiPM: %.1f kHz (Tăng %.1f%% do nhiệt)\n', ...
    T_env, DCR_actual/1e3, (DCR_actual/DCR_25C - 1)*100);
fprintf('Điện áp đánh thủng V_br thực tế: %.3f V (Đã trôi +%.1f mV)\n', ...
    V_br_actual, (V_br_actual - V_br_ref)*1e3);
