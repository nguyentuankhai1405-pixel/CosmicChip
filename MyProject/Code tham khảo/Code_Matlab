%% Test Roi luong tu
clc; clear; close all;
N_pairs = 10000; % So cap photon roi duoc do
theta_A = 0;     % Alice co dinh may do o 0 rad
beta_deg = linspace(0, 180, 50); % Bob xoay may do tu 0 den 180 do
beta_rad = deg2rad(beta_deg);

E_quantum_sim = zeros(size(beta_rad));
E_classical_limit = 1 - 2*beta_rad/pi; % Gioi han toi da cua co hoc co dien

for i = 1:length(beta_rad)
    theta_B = beta_rad(i);
    delta_theta = theta_A - theta_B;

    % Xac suat luong tu do duoc 2 spin dong thuan (+1,+1 hoac -1,-1)
    P_same = cos(delta_theta)^2; 

    % Monte Carlo tao cac phep do thuc te
    measurements = rand(N_pairs, 1) < P_same; % 1: cung chieu (+1), 0: trai chieu (-1)
    % Gia tri tuong quan thuc nghiem E = (N_same - N_diff) / N_total
    E_quantum_sim(i) = (sum(measurements) - sum(~measurements)) / N_pairs;
end

% Du doan ly thuyet co hoc luong tu
E_theory = cos(2 * (theta_A - beta_rad));

figure('Color', 'w', 'Position', [100, 100, 750, 500]);
plot(beta_deg, E_theory, 'b-', 'LineWidth', 2.5, 'DisplayName', 'Ly thuyet Luong tu: cos(2\Delta\theta)');
hold on;
plot(beta_deg, E_quantum_sim, 'ro', 'MarkerSize', 5, 'DisplayName', 'Mo phong Monte Carlo (N=10^4)');
plot(beta_deg, E_classical_limit, 'k--', 'LineWidth', 1.5, 'DisplayName', 'Gioi han Co dien Bell (Local Realism)');
plot(beta_deg, -E_classical_limit, 'k--', 'LineWidth', 1.5, 'HandleVisibility', 'off');

grid on; ylim([-1.2 1.2]);
title('Kiem chung Bat dang thuc Bell: Vi pham gioi han co dien do Roi luong tu', 'FontSize', 12);
xlabel('Goc may do cua Bob \beta (do)'); ylabel('He so tuong quan E(\alpha, \beta)');
legend('Location', 'southwest');


